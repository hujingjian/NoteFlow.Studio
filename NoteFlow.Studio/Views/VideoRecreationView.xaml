<UserControl x:Class="NoteFlow.Studio.Views.VideoRecreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="{StaticResource AppRootBackground}">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextForeground}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,50,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="视频片段复刻" Foreground="{StaticResource AppTextForeground}" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="截取参考片段，让 AI 拆解视觉语言并生成可编辑的 HTML 动效" Foreground="{StaticResource AppTextMuted}" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnOpenVideo" Click="BtnOpenVideo_Click" Style="{DynamicResource MaterialDesignRaisedButton}"
                    Background="{StaticResource AppPrimaryAccent}" Foreground="White" Padding="18,9" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="VideoPlusOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="导入本地视频"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" MinWidth="520"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#090B10" CornerRadius="12" ClipToBounds="True" MinHeight="330">
                    <Grid x:Name="VideoContainer" SizeChanged="VideoContainer_SizeChanged">
                        <vlc:VideoView x:Name="VideoPlayer"/>
                        <StackPanel x:Name="EmptyVideoState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="70" Height="70" CornerRadius="35" Background="#202433" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="MovieOpenOutline" Foreground="#7279F4" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="导入一段参考视频" Foreground="#D9DAE2" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock Text="支持 MP4、MOV、MKV、AVI、WebM" Foreground="{StaticResource AppTextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Popup x:Name="CropPopup" AllowsTransparency="True" StaysOpen="True"
                               PlacementTarget="{Binding ElementName=VideoContainer}" Placement="Center"
                               Width="{Binding ElementName=VideoContainer, Path=ActualWidth}"
                               Height="{Binding ElementName=VideoContainer, Path=ActualHeight}">
                            <Grid Background="#44000000">
                                <Canvas x:Name="CropCanvas" Background="#01000000"
                                        MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown"
                                        MouseMove="CropCanvas_MouseMove"
                                        MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp">
                                    <Rectangle x:Name="CropRectangle" Stroke="#7279F4" StrokeThickness="2" Fill="#22414DE5"/>
                                </Canvas>
                                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Background="#D911131B" CornerRadius="7" Padding="12,7" IsHitTestVisible="False">
                                    <TextBlock Text="拖动框选要发送给 AI 的画面区域" Foreground="White" FontSize="12"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                    <Button Click="BtnResetCrop_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="#8B8F9A" Margin="0,0,8,0" Padding="12,5" Content="重置全画面"/>
                                    <Button Click="BtnCancelCrop_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" Foreground="White" BorderBrush="#8B8F9A" Margin="0,0,8,0" Padding="12,5" Content="取消"/>
                                    <Button Click="BtnConfirmCrop_Click" Style="{DynamicResource MaterialDesignRaisedButton}" Background="{StaticResource AppPrimaryAccent}" Foreground="White" Padding="14,5" Content="确认裁剪"/>
                                </StackPanel>
                            </Grid>
                        </Popup>
                    </Grid>
                </Border>

                <materialDesign:Card Grid.Row="1" Margin="0,14,0,0" Padding="16" Background="{StaticResource AppCardBackground}" UniformCornerRadius="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="BtnPlayPause" Click="BtnPlayPause_Click" Style="{DynamicResource MaterialDesignIconButton}" IsEnabled="False" Foreground="White" ToolTip="播放/暂停">
                                    <materialDesign:PackIcon x:Name="PlayPauseIcon" Kind="Play"/>
                                </Button>
                                <Button Click="BtnJumpBack_Click" Style="{DynamicResource MaterialDesignIconButton}" IsEnabled="{Binding IsEnabled, ElementName=BtnPlayPause}" Foreground="{StaticResource AppTextMuted}" ToolTip="后退 1 秒">
                                    <materialDesign:PackIcon Kind="Rewind10"/>
                                </Button>
                                <Button Click="BtnJumpForward_Click" Style="{DynamicResource MaterialDesignIconButton}" IsEnabled="{Binding IsEnabled, ElementName=BtnPlayPause}" Foreground="{StaticResource AppTextMuted}" ToolTip="前进 1 秒">
                                    <materialDesign:PackIcon Kind="FastForward10"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="BtnCrop" Click="BtnCrop_Click" IsEnabled="False" Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="10,4" Height="30">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Crop" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="裁剪画面" FontSize="12"/></StackPanel>
                                </Button>
                                <TextBlock x:Name="TxtCropSummary" Text="全画面" Foreground="{StaticResource AppTextMuted}" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="TxtPlayerTime" Text="00:00.000 / 00:00.000" Foreground="#C6C8D2" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <Slider x:Name="PlaybackSlider" Minimum="0" Maximum="1" Margin="2,4,2,8" IsEnabled="False"
                                ValueChanged="PlaybackSlider_ValueChanged" PreviewMouseLeftButtonDown="PlaybackSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PlaybackSlider_PreviewMouseLeftButtonUp"/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="片段时间轴" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#202433" CornerRadius="6" Padding="9,4">
                                <TextBlock x:Name="TxtSelectionDuration" Text="已选 00:00.000" Foreground="#AEB2FF" FontSize="12"/>
                            </Border>
                        </Grid>

                        <Grid x:Name="TimelineHost" Height="66" Margin="0,12,0,8" SizeChanged="TimelineHost_SizeChanged" Background="#0D0F16" ClipToBounds="True">
                            <ItemsControl x:Name="ThumbnailStrip">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><Image Source="{Binding}" Stretch="UniformToFill"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="SelectionOverlay" Height="66" Background="#24414DE5" BorderBrush="#7279F4" BorderThickness="2" CornerRadius="4"/>
                                <Border x:Name="Playhead" Width="2" Height="66" Background="White"/>
                            </Canvas>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid><TextBlock Text="入点" Style="{StaticResource MutedText}"/><TextBlock x:Name="TxtInPoint" Text="00:00.000" Foreground="#72D6B9" FontFamily="Consolas" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="InPointSlider" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="InPointSlider_ValueChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid><TextBlock Text="出点" Style="{StaticResource MutedText}"/><TextBlock x:Name="TxtOutPoint" Text="00:00.000" Foreground="#FFB86C" FontFamily="Consolas" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="OutPointSlider" Minimum="0" Maximum="1" IsEnabled="False" Value="1" ValueChanged="OutPointSlider_ValueChanged"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="ChkLoopSelection" Content="循环播放选中片段" Foreground="{StaticResource AppTextMuted}" IsChecked="True" Margin="0,9,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <materialDesign:Card Grid.Column="2" Background="{StaticResource AppCardBackground}" UniformCornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="AI 视觉复刻" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="抽取片段关键帧，分析字体、图形、构图、转场和动画节奏。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,18,0,14">
                        <TextBlock Text="分析模型" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbVisionModel" DisplayMemberPath="Name" Style="{DynamicResource MaterialDesignOutlinedComboBox}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="每秒抽帧" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbFrameRate" SelectedIndex="2" Style="{DynamicResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="1 帧/秒" Tag="1"/>
                                    <ComboBoxItem Content="2 帧/秒" Tag="2"/>
                                    <ComboBoxItem Content="4 帧/秒" Tag="4"/>
                                    <ComboBoxItem Content="6 帧/秒" Tag="6"/>
                                    <ComboBoxItem Content="10 帧/秒" Tag="10"/>
                                    <ComboBoxItem Content="16 帧/秒" Tag="16"/>
                                    <ComboBoxItem Content="24 帧/秒" Tag="24"/>
                                    <ComboBoxItem Content="30 帧/秒" Tag="30"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="输出比例" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbAspectRatio" SelectedIndex="0" Style="{DynamicResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="跟随原视频"/><ComboBoxItem Content="16:9"/><ComboBoxItem Content="9:16"/><ComboBoxItem Content="1:1"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="补充要求（可选）" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                        <TextBox x:Name="TxtExtraRequirements" MinHeight="60" MaxHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                                 materialDesign:HintAssist.Hint="例如：重点还原标题动效；使用 CSS + SVG" Style="{DynamicResource MaterialDesignOutlinedTextBox}"/>
                        <Button x:Name="BtnAnalyze" Click="BtnAnalyze_Click" IsEnabled="False" Margin="0,12,0,0" Height="42"
                                Style="{DynamicResource MaterialDesignRaisedButton}" Background="{StaticResource AppPrimaryAccent}" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AutoFix" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtAnalyzeButton" Text="分析并生成 HTML"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar x:Name="AnalysisProgress" IsIndeterminate="True" Visibility="Collapsed" Height="3" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtStatus" Text="请先导入视频并选择片段" Foreground="{StaticResource AppTextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>

                    <TabControl Grid.Row="2" x:Name="ResultTabs" Background="Transparent">
                        <TabItem Header="视觉拆解">
                            <TextBox x:Name="TxtAnalysisResult" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="#0D0F16" Foreground="#D8DAE4" BorderThickness="0" Padding="12" Text="分析结果会显示在这里。"/>
                        </TabItem>
                        <TabItem Header="HTML 代码">
                            <TextBox x:Name="TxtHtmlResult" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#0D0F16" Foreground="#B7E3CE" BorderThickness="0" Padding="12" FontFamily="Consolas" FontSize="12" Text="生成的 HTML 会显示在这里。"/>
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="BtnCopyHtml" Click="BtnCopyHtml_Click" IsEnabled="False" Style="{DynamicResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentCopy" Margin="0,0,7,0"/><TextBlock Text="复制 HTML"/></StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="BtnSaveHtml" Click="BtnSaveHtml_Click" IsEnabled="False" Style="{DynamicResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSaveOutline" Margin="0,0,7,0"/><TextBlock Text="保存文件"/></StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
