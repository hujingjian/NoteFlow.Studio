<UserControl x:Class="NoteFlow.Studio.Views.VideoGeneration.AnimationGenerationTabPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SubTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextForeground}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Content}" 
                                           Padding="10,5,10,5"
                                           HorizontalAlignment="Center"/>
                                <Border x:Name="Underline" 
                                        Height="2" 
                                        Background="{StaticResource AppPrimaryAccent}" 
                                        Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource AppPrimaryAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                 <Setter Property="Foreground" Value="{StaticResource AppPrimaryAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPanel" Width="0.8*"/>
            <ColumnDefinition x:Name="PreviewColumn" Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧区域 -->
        <Grid Grid.Column="0" Margin="20,10,10,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                <StackPanel>
                    <!-- 1. 分镜列表 -->
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="1. 分镜列表" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnSaveAllHtml" Click="BtnSaveAllHtml_Click" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Right" Padding="10,0" Height="28">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderDownload" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="一键保存HTML" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- 用于存放解析后的脚本内容文本（作为原始数据）或者 ListView。由于暂无后端实体，目前使用简单的 ListBox 模拟分镜卡片，或绑定到解析集合 -->
                        <TextBox x:Name="TxtScriptRaw" Visibility="Collapsed"/>
                        <ListBox x:Name="LstStoryboards" PreviewMouseWheel="LstStoryboards_PreviewMouseWheel" MaxHeight="300" Margin="0,0,0,15" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="LstStoryboards_SelectionChanged" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,0,0,5"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1C1F2B" CornerRadius="6" Padding="6,4,4,4" Margin="4,4,4,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <RadioButton Grid.Column="0" Content="" IsChecked="{Binding IsReference}" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" GroupName="RefTabs" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource AppPrimaryAccent}"/>

                                            <Border Grid.Column="1" Background="#2D3243" CornerRadius="4" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Index}" Foreground="{StaticResource AppPrimaryAccent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource AppTextForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TimeRange}" Foreground="{StaticResource AppTextMuted}" FontSize="12" Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="3" Background="#163823" BorderBrush="#1C5B33" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="已完成" Foreground="#4ADE80" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="0,5,0,5">
                            <TextBlock Text="2. 提示词" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox x:Name="CmbPrompts" SelectionChanged="CmbPrompts_SelectionChanged" DisplayMemberPath="Title" Style="{DynamicResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="选择提示词"/>
                                <TextBox x:Name="TxtPromptTitle" Visibility="Collapsed" Style="{DynamicResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="输入提示词标题..."/>
                                
                                <StackPanel x:Name="StkActionButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button x:Name="BtnAddPrompt" Click="BtnAddPrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="新增"><materialDesign:PackIcon Kind="Add"/></Button>
                                    <Button x:Name="BtnEditPrompt" Click="BtnEditPrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="编辑并替换当前内容"><materialDesign:PackIcon Kind="Pencil"/></Button>
                                    <Button x:Name="BtnDeletePrompt" Click="BtnDeletePrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="删除"><materialDesign:PackIcon Kind="Delete"/></Button>
                                </StackPanel>

                                <StackPanel x:Name="StkEditButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                                    <Button x:Name="BtnSavePrompt" Click="BtnSavePrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="保存" Foreground="LimeGreen"><materialDesign:PackIcon Kind="Check"/></Button>
                                    <Button x:Name="BtnCancelPrompt" Click="BtnCancelPrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="取消" Foreground="IndianRed"><materialDesign:PackIcon Kind="Close"/></Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="3. 动画风格偏好" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbStyles" SelectionChanged="CmbStyles_SelectionChanged" DisplayMemberPath="Name" Style="{DynamicResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="选择动画风格"/>
                        </StackPanel>

                        <Border Background="#1C1F2B" CornerRadius="6" Padding="10" Margin="0,10,0,10" BorderBrush="#2D3243" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource AppPrimaryAccent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="提示词说明" Foreground="{StaticResource AppPrimaryAccent}" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="TxtFullPrompt" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="150" Style="{DynamicResource MaterialDesignTextBox}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource AppTextForeground}" VerticalContentAlignment="Top" materialDesign:HintAssist.Hint="最终用于生成动画的提示词..."/>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,10,0,10">
                            <TextBlock Text="4. 脚本要求选项" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <CheckBox x:Name="ChkAllowCenterArea" Content="允许占用中心区域" Margin="0,8,0,0" Checked="AnimationPromptOption_Checked" Unchecked="AnimationPromptOption_Unchecked" Foreground="{StaticResource AppTextForeground}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="1" x:Name="BtnSendPrompt" Click="BtnSendPrompt_Click" Style="{DynamicResource MaterialDesignRaisedButton}" Background="{StaticResource AppPrimaryAccent}" Margin="0,10,0,0" Height="40" materialDesign:ButtonAssist.CornerRadius="6" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Send" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="发送给AI生成HTML" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 右侧区域 -->
        <Grid Grid.Column="1" Margin="10,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="5. HTML 动画预览" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,10"/>
            
            <Grid Grid.Row="0" Margin="0,25,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabHtmlEdit" Content="动画脚本(HTML)" GroupName="PreviewTabs" IsChecked="True" Style="{StaticResource SubTabButtonStyle}" Click="PreviewTab_Click" Margin="0,0,10,0"/>
                    <RadioButton x:Name="TabHtmlPreview" Content="动画预览(效果)" GroupName="PreviewTabs" Style="{StaticResource SubTabButtonStyle}" Click="PreviewTab_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenInBrowser" Click="BtnOpenInBrowser_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="10,0" Height="28" Content="打开浏览器查看" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSaveHtml" Click="BtnSaveHtml_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" Padding="10,0" Height="28" Content="保存 HTML"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#1C1F2B" CornerRadius="6" Padding="10" BorderBrush="#2D3243" BorderThickness="1">
                <Grid x:Name="BrowserContainer">
                    <!-- 放大/还原按钮 → 直接放在整个 Border 的右上角 -->
                    <Button x:Name="BtnToggleZoom" 
                        Click="BtnToggleZoom_Click" 
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0"
                        ToolTip="放大/还原"
                        Panel.ZIndex="99">
                        <materialDesign:PackIcon x:Name="ZoomIcon" Kind="ArrowExpand"/>
                    </Button>
                    <!-- HTML 编辑区 -->
                    <TextBox x:Name="TxtHtmlContent" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppTextForeground}" FontFamily="Consolas" Visibility="Visible" materialDesign:HintAssist.Hint="将AI生成的HTML代码粘贴到这里..."/>
                    <!-- 预览浏览器容器 -->
                    <Viewbox x:Name="PreviewViewbox" Stretch="Uniform" Visibility="Collapsed">
                        <Grid x:Name="BrowserWrapper" Width="1920" Height="1080">
                            <!-- 预览浏览器将会在代码中动态生成，防止多个CefBrowser实例导致输入法丢失焦点、位置漂移等问题 -->
                        </Grid>
                    </Viewbox>

                    
                    <!-- 预览浏览器将会在代码中动态生成，防止多个CefBrowser实例导致输入法丢失焦点、位置漂移等问题 -->
                </Grid>
            </Border>

            <!-- 导出设置 -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0" x:Name="ExportSettings">
                <TextBlock Text="6. 导出动画设置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="分辨率" Foreground="{StaticResource AppTextMuted}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbResolution" SelectionChanged="CmbResolution_SelectionChanged" SelectedIndex="0" Style="{DynamicResource MaterialDesignOutlinedComboBox}" Padding="8">
                            <ComboBoxItem Content="1920x1080 (16:9)"/>
                            <ComboBoxItem Content="1080x1920 (9:16)"/>
                            <ComboBoxItem Content="1080x1080 (1:1)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="帧率 (FPS)" Foreground="{StaticResource AppTextMuted}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbFps" SelectedIndex="1" Style="{DynamicResource MaterialDesignOutlinedComboBox}" Padding="8">
                            <ComboBoxItem Content="24"/>
                            <ComboBoxItem Content="30"/>
                            <ComboBoxItem Content="60"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="5,0,0,0" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkTransparentBg" Content="透明背景" Foreground="{StaticResource AppTextForeground}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnExportVideo" Grid.Column="0" Click="BtnExportVideo_Click" Style="{DynamicResource MaterialDesignRaisedButton}" Background="#DC2626" Height="40" materialDesign:ButtonAssist.CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MoviePlay" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="进行录制与导出" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnBatchExportVideo" Grid.Column="2" Click="BtnBatchExportVideo_Click" Style="{DynamicResource MaterialDesignRaisedButton}" Background="#D97706" Height="40" materialDesign:ButtonAssist.CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconBatchExport" Kind="AnimationPlay" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtBatchExport" Text="一键批量录制" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
