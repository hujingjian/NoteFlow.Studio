<UserControl x:Class="NoteFlow.Studio.Views.VideoGeneration.ScriptGenerationTabPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧区域 -->
        <Grid Grid.Column="0" Margin="20,10,10,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <!-- 1. 确认清洗后的文案 -->
                    <StackPanel>
                        <TextBlock Text="1. 确认清洗后的文案" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtScriptCleanedText" Margin="0,0,0,0" Height="150" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{DynamicResource MaterialDesignOutlinedTextBox}" VerticalContentAlignment="Top" materialDesign:HintAssist.Hint="清洗后的文案内容..." TextChanged="TxtScriptCleanedText_TextChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0">
                        <Button x:Name="BtnToggleChunkPanel" Click="BtnToggleChunkPanel_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" HorizontalContentAlignment="Stretch" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="IconChunkPanelToggle" Kind="ChevronDown" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="2. 内容分块 / 3. 分块预览与管理" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <StackPanel x:Name="StkChunkPanelContent" Visibility="Collapsed">
                            <!-- 新增：AI分块设置 -->
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="2. 内容分块 (为避免上下文限制，建议分块生成)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,10"/>
                                <Border Background="#1C1F2B" CornerRadius="6" Padding="15" BorderBrush="#2D3243" BorderThickness="1">
                                    <StackPanel>
                                        <!-- 分块方式 -->
                                        <TextBlock Text="分块方式" Foreground="{StaticResource AppTextMuted}" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <RadioButton x:Name="RbChunkWord" Content="按字数切割" Style="{StaticResource MaterialDesignTabRadioButton}" GroupName="ChunkMethod" IsChecked="True" Margin="0,0,10,0"/>
                                            <RadioButton x:Name="RbChunkPara" Content="按段落切割" Style="{StaticResource MaterialDesignTabRadioButton}" GroupName="ChunkMethod" Margin="0,0,10,0"/>
                                            <RadioButton x:Name="RbChunkCustom" Content="自定义分块" Style="{StaticResource MaterialDesignTabRadioButton}" GroupName="ChunkMethod"/>
                                        </StackPanel>

                                        <!-- 每块字数上限 -->
                                        <TextBlock Text="每块字数上限" Foreground="{StaticResource AppTextMuted}" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <RadioButton x:Name="RbWords200" Content="200字" Style="{StaticResource MaterialDesignTabRadioButton}" GroupName="ChunkWords" Margin="0,0,10,0" Checked="RbWords_Checked"/>
                                            <RadioButton x:Name="RbWords500" Content="500字" Style="{StaticResource MaterialDesignTabRadioButton}" GroupName="ChunkWords" IsChecked="True" Margin="0,0,10,0" Checked="RbWords_Checked"/>
                                            <RadioButton x:Name="RbWords800" Content="800字" Style="{StaticResource MaterialDesignTabRadioButton}" GroupName="ChunkWords" Margin="0,0,10,0" Checked="RbWords_Checked"/>
                                            <RadioButton x:Name="RbWords1000" Content="1000字" Style="{StaticResource MaterialDesignTabRadioButton}" GroupName="ChunkWords" Margin="0,0,10,0" Checked="RbWords_Checked"/>
                                            <RadioButton x:Name="RbWordsCustom" Content="自定义" Style="{StaticResource MaterialDesignTabRadioButton}" GroupName="ChunkWords" Checked="RbWords_Checked"/>
                                        </StackPanel>
                                        <Slider x:Name="SldMaxWords" Minimum="100" Maximum="2000" Value="500" TickFrequency="100" IsSnapToTickEnabled="True" Margin="0,0,0,15" ValueChanged="SldMaxWords_ValueChanged"/>

                                        <!-- 估算与按钮 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TbChunkEstimate" Text="预计分为 1 块 (共 0 字)" VerticalAlignment="Center" Foreground="{StaticResource AppTextMuted}"/>
                                            <Button Grid.Column="1" x:Name="BtnInvokeAiChunking" Content="重新分块" Click="BtnInvokeAiChunking_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" Height="30" Padding="15,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 新增：AI分块预览与管理 -->
                            <StackPanel Margin="0,20,0,0">
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="3. 分块预览与管理" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnAddChunk" Click="BtnAddChunk_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="手动添加分块"><materialDesign:PackIcon Kind="Add"/></Button>
                                        <Button x:Name="BtnClearChunks" Click="BtnClearChunks_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="清空所有分块" Margin="5,0,0,0"><materialDesign:PackIcon Kind="DeleteSweep"/></Button>
                                    </StackPanel>
                                </Grid>
                                <Border Background="#1C1F2B" CornerRadius="6" Padding="10" BorderBrush="#2D3243" BorderThickness="1">
                                    <ListBox x:Name="LstAiChunks" Height="200" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2D3243" CornerRadius="4" Padding="10" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Foreground="{StaticResource AppTextForeground}" Background="Transparent" BorderThickness="0" MinHeight="30" VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto" MaxHeight="100"/>
                                                        <Button Grid.Column="1" Click="BtnDeleteChunk_Click" Style="{StaticResource MaterialDesignToolButton}" Foreground="IndianRed" ToolTip="删除此分配" VerticalAlignment="Top" Margin="10,0,0,0">
                                                            <materialDesign:PackIcon Kind="Delete"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- 4. 选择分镜脚本提示词 -->
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="4. 选择分镜脚本提示词" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox x:Name="CmbScriptPrompts" SelectionChanged="CmbScriptPrompts_SelectionChanged" DisplayMemberPath="Title" Style="{DynamicResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="选择一个预设提示词"/>
                            <TextBox x:Name="TxtScriptPromptTitle" Visibility="Collapsed" Style="{DynamicResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="输入提示词标题..."/>
                            
                            <StackPanel x:Name="StkScriptActionButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button x:Name="BtnAddScriptPrompt" Click="BtnAddScriptPrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="新增"><materialDesign:PackIcon Kind="Add"/></Button>
                                <Button x:Name="BtnEditScriptPrompt" Click="BtnEditScriptPrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="编辑并替换当前内容"><materialDesign:PackIcon Kind="Pencil"/></Button>
                                <Button x:Name="BtnDeleteScriptPrompt" Click="BtnDeleteScriptPrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="删除"><materialDesign:PackIcon Kind="Delete"/></Button>
                            </StackPanel>

                            <StackPanel x:Name="StkScriptEditButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnSaveScriptPrompt" Click="BtnSaveScriptPrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="保存" Foreground="LimeGreen"><materialDesign:PackIcon Kind="Check"/></Button>
                                <Button x:Name="BtnCancelScriptPrompt" Click="BtnCancelScriptPrompt_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="取消" Foreground="IndianRed"><materialDesign:PackIcon Kind="Close"/></Button>
                            </StackPanel>
                        </Grid>

                        <Border Background="#1C1F2B" CornerRadius="6" Padding="10" Margin="0,10,0,0" BorderBrush="#2D3243" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource AppPrimaryAccent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="提示词说明" Foreground="{StaticResource AppPrimaryAccent}" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBox x:Name="TxtScriptFullPrompt" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="150" Style="{DynamicResource MaterialDesignTextBox}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource AppTextForeground}" VerticalContentAlignment="Top" materialDesign:HintAssist.Hint="最终用于生成脚本的完整提示词..."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5. 脚本要求选项 -->
                    <StackPanel Margin="0,20,0,10">
                        <TextBlock Text="5. 脚本要求选项" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <CheckBox x:Name="ChkScriptOpt1" Content="按黄金3秒拆分开头" Checked="ScriptPromptOption_Checked" Unchecked="ScriptPromptOption_Unchecked" Foreground="{StaticResource AppTextForeground}"/>
                                <CheckBox x:Name="ChkScriptOpt2" Content="包含BGM/音效提示" Margin="0,8,0,0" Checked="ScriptPromptOption_Checked" Unchecked="ScriptPromptOption_Unchecked" Foreground="{StaticResource AppTextForeground}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <CheckBox x:Name="ChkScriptOpt3" Content="增加画面视觉描述" Checked="ScriptPromptOption_Checked" Unchecked="ScriptPromptOption_Unchecked" Foreground="{StaticResource AppTextForeground}"/>
                                <CheckBox x:Name="ChkScriptOpt4" Content="输出 JSON 表格格式" Margin="0,8,0,0" Checked="ScriptPromptOption_Checked" Unchecked="ScriptPromptOption_Unchecked" Foreground="{StaticResource AppTextForeground}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1" x:Name="BtnStartGenerateScript" Click="BtnStartGenerateScript_Click" Style="{DynamicResource MaterialDesignRaisedButton}" Background="{StaticResource AppPrimaryAccent}" Height="40" materialDesign:ButtonAssist.CornerRadius="6" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MovieEdit" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="开始分块生成提示词" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 右侧区域 -->
        <Grid Grid.Column="1" Margin="10,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="5. 分镜与脚本预览" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextForeground}" Margin="0,0,0,10"/>
            
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnReadScriptClipboard" Content="从剪贴板读取" Click="BtnReadScriptClipboard_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Padding="10,0" Height="28"/>
                <Button Content="导出 JSON" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,5,0" Padding="10,0" Height="28"/>
            </StackPanel>
            
            <TextBox Grid.Row="2" x:Name="TxtScriptResult" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" Style="{DynamicResource MaterialDesignOutlinedTextBox}" VerticalContentAlignment="Top" Background="#161923" Foreground="{StaticResource AppTextForeground}"/>
            
            <Button Grid.Row="3" x:Name="BtnGoToAnimation" Content="下一步：生成分镜动画" Click="BtnGoToAnimation_Click" Style="{DynamicResource MaterialDesignRaisedButton}" Background="{StaticResource AppPrimaryAccent}" Margin="0,15,0,0" Height="40" materialDesign:ButtonAssist.CornerRadius="6"/>
        </Grid>
    </Grid>
</UserControl>
