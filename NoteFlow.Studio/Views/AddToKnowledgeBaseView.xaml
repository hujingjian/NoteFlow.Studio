<UserControl x:Class="NoteFlow.Studio.Views.AddToKnowledgeBaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200" TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部信息区 -->
        <Border Grid.Row="0" Margin="20,10,20,10" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Button x:Name="BtnBack" Click="BtnBack_Click" Style="{DynamicResource MaterialDesignFlatButton}" Foreground="#8B8F9A" Margin="-10,20,0,5" HorizontalAlignment="Left" Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" VerticalAlignment="Center"/>
                            <TextBlock Text="返回" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="TxtTitle" Text="加入知识库: 暂无视频" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="来源：" Foreground="#8B8F9A" FontSize="12"/>
                        <TextBlock x:Name="TxtPlatform" Text="--" Foreground="#E2E2E6" FontSize="12" Margin="5,0,15,0"/>
                        <TextBlock Text="时长：" Foreground="#8B8F9A" FontSize="12"/>
                        <TextBlock x:Name="TxtDuration" Text="--" Foreground="#E2E2E6" FontSize="12" Margin="5,0,15,0"/>
                        <TextBlock Text="大小：" Foreground="#8B8F9A" FontSize="12"/>
                        <TextBlock x:Name="TxtSize" Text="--" Foreground="#E2E2E6" FontSize="12" Margin="5,0,15,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnToggleTask" Content="开始任务" IsEnabled="False" Style="{DynamicResource MaterialDesignRaisedButton}" Background="#414DE5" Foreground="White" VerticalAlignment="Center" Click="BtnToggleTask_Click"/>
            </Grid>
        </Border>

        <!-- 主体布局 -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PlayerColumn" Width="3*"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="20"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧核心处理流程 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 流程进度条 -->
                <materialDesign:Card Grid.Row="0" Background="#161923" UniformCornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <Grid>
                        <!-- 等距分4列模拟步骤 -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 第1步 -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon x:Name="IconStep1" Kind="CircleOutline" Foreground="#3A3A49" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStep1" Text="1. 下载视频" Foreground="#8B8F9A" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtStep1Desc" Text="等待任务开始..." Foreground="#8B8F9A" FontSize="12" Margin="34,0,0,0"/>
                            <ProgressBar x:Name="ProgStep1" Value="0" Margin="34,5,10,0" Height="2" Foreground="#22C55E" Background="#2B2D38" BorderThickness="0" Maximum="100"/>
                        </StackPanel>

                        <!-- 第2步 -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon x:Name="IconStep2" Kind="CircleOutline" Foreground="#3A3A49" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStep2" Text="2. 提取文案" Foreground="#8B8F9A" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <Button x:Name="BtnReExtract" Content="重新提取" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="10,0,0,0" Padding="8,0" Height="24" FontSize="12" Click="BtnReExtract_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtStep2Desc" Text="准备识别..." Foreground="#8B8F9A" FontSize="12" Margin="34,0,0,0"/>
                            <ProgressBar x:Name="ProgStep2" Visibility="Collapsed" Value="0" Margin="34,5,10,0" Height="2" Foreground="#414DE5" Background="#2B2D38" BorderThickness="0" Maximum="100"/>
                        </StackPanel>

                        <!-- 第3步 -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon x:Name="IconStep3" Kind="CircleOutline" Foreground="#3A3A49" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock Text="3. 生成 Markdown" Foreground="#8B8F9A" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtStep3Desc" Text="AI 结构化内容" Foreground="#8B8F9A" FontSize="12" Margin="34,0,0,0"/>
                        </StackPanel>

                        <!-- 第4步 -->
                        <StackPanel Grid.Column="3">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon x:Name="IconStep4" Kind="CircleOutline" Foreground="#3A3A49" Width="24" Height="24" VerticalAlignment="Center"/>
                                <TextBlock Text="4. 归档到 Obsidian" Foreground="#8B8F9A" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtStep4Desc" Text="等待归档..." Foreground="#8B8F9A" FontSize="12" Margin="34,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- 内容区 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="InnerVideoColumn" Width="1*"/>
                        <ColumnDefinition x:Name="InnerSplitterColumn" Width="15"/>
                        <ColumnDefinition x:Name="InnerOcrColumn" Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧半边：视频与选项 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 移除 ClipToBounds 和 UniformCornerRadius，防止 WPF 渲染限制导致 LibVLCSharp HWND 弹出新独立窗口 -->
                        <Border x:Name="PlayerBorder" Grid.Row="0" Background="Black" Height="250" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" x:Name="VideoContainer" SizeChanged="VideoContainer_SizeChanged">
                                    <TextBlock x:Name="TxtVideoStatus" Text="等待下载视频..." Foreground="#8B8F9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <vlc:VideoView x:Name="VideoPlayer" Visibility="Collapsed" Unloaded="VideoPlayer_Unloaded"/>
                                    
                                    <Popup x:Name="CropOverlayPopup" AllowsTransparency="True" 
                                           PlacementTarget="{Binding ElementName=VideoContainer}" Placement="Center"
                                           Width="{Binding ElementName=VideoContainer, Path=ActualWidth}"
                                           Height="{Binding ElementName=VideoContainer, Path=ActualHeight}">
                                        <Canvas x:Name="CanvasCropOverlay" Background="#01000000" 
                                                MouseLeftButtonDown="CanvasCropOverlay_MouseLeftButtonDown" 
                                                MouseMove="CanvasCropOverlay_MouseMove" 
                                                MouseLeftButtonUp="CanvasCropOverlay_MouseLeftButtonUp">
                                            <Rectangle x:Name="CropRectangle" Stroke="Red" StrokeThickness="2" Fill="#33FF0000" Visibility="Collapsed"/>
                                        </Canvas>
                                    </Popup>
                                </Grid>

                                <Grid x:Name="PanelVideoControls" Grid.Row="1" Background="#1E1E24" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- 进度条单独占一行，宽度拉满 -->
                                    <Slider x:Name="VideoSlider" Grid.Row="0" VerticalAlignment="Center" Margin="10,5,10,0" Minimum="0" Maximum="1" Value="0" ValueChanged="VideoSlider_ValueChanged" PreviewMouseLeftButtonDown="VideoSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="VideoSlider_PreviewMouseLeftButtonUp" />
                                    
                                    <!-- 底部操作按钮和时间分居左右 -->
                                    <Grid Grid.Row="1" Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Button Click="BtnRewind_Click" Style="{DynamicResource MaterialDesignIconButton}" Foreground="White" Width="30" Height="30" ToolTip="后退3秒"><materialDesign:PackIcon Kind="Rewind" /></Button>
                                            <Button Click="BtnPlay_Click" Style="{DynamicResource MaterialDesignIconButton}" Foreground="White" Width="30" Height="30"><materialDesign:PackIcon Kind="Play" /></Button>
                                            <Button Click="BtnPause_Click" Style="{DynamicResource MaterialDesignIconButton}" Foreground="White" Width="30" Height="30"><materialDesign:PackIcon Kind="Pause" /></Button>
                                            <Button Click="BtnStop_Click" Style="{DynamicResource MaterialDesignIconButton}" Foreground="White" Width="30" Height="30"><materialDesign:PackIcon Kind="Stop" /></Button>
                                            <Button Click="BtnFastForward_Click" Style="{DynamicResource MaterialDesignIconButton}" Foreground="White" Width="30" Height="30" ToolTip="快进3秒"><materialDesign:PackIcon Kind="FastForward" /></Button>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,15,0">
                                            <TextBlock x:Name="TxtVideoTime" Foreground="White" Text="00:00 / 00:00" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <Button x:Name="BtnToggleFullScreen" Click="BtnToggleFullScreen_Click" Style="{DynamicResource MaterialDesignIconButton}" Foreground="White" Width="30" Height="30" ToolTip="影院模式">
                                                <materialDesign:PackIcon x:Name="IconFullScreen" Kind="Fullscreen" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <materialDesign:Card Grid.Row="1" Background="#161923" UniformCornerRadius="12" Padding="15">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="文案提取方式:" Foreground="#8B8F9A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CmbExtractMethod" Style="{DynamicResource MaterialDesignOutlinedComboBox}" Width="200" SelectionChanged="CmbExtractMethod_SelectionChanged">
                                        <ComboBoxItem Content="字幕区域OCR" IsSelected="True"/>
                                        <ComboBoxItem Content="whisper语音识别"/>
                                        <ComboBoxItem Content="截图识别"/>
                                        <ComboBoxItem x:Name="CmbItemYtDlpSubtitle" Content="字幕提取" Visibility="Collapsed"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Whisper及其他选项容器 -->
                                <Grid Grid.Row="1">
                                        <StackPanel x:Name="PanelWhisperConfig" Visibility="Collapsed">
                                        <TextBlock Text="Whisper 识别模型" Foreground="#8B8F9A" Margin="0,0,0,5"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbWhisperModel" Width="300" HorizontalAlignment="Left" Grid.Column="0" Style="{DynamicResource MaterialDesignOutlinedComboBox}" SelectionChanged="CmbWhisperModel_SelectionChanged">
                                            </ComboBox>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock x:Name="TxtWhisperModelStatus" Text="检测中..." Foreground="#8B8F9A" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                                <Button x:Name="BtnDownloadWhisperModel" Content="下载" Style="{DynamicResource MaterialDesignOutlinedButton}" Visibility="Collapsed" Click="BtnDownloadWhisperModel_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar x:Name="ProgWhisperDownload" Visibility="Collapsed" Margin="0,0,0,10" Height="2" Minimum="0" Maximum="100"/>
                                        
                                        <TextBlock Text="语言" Foreground="#8B8F9A" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="CmbWhisperLanguage" Width="300" HorizontalAlignment="Left" Style="{DynamicResource MaterialDesignOutlinedComboBox}">
                                            <ComboBoxItem Content="自动识别 (auto)" Tag="auto"/>
                                            <ComboBoxItem Content="中文 (zh)" Tag="zh" IsSelected="True"/>
                                            <ComboBoxItem Content="英文 (en)" Tag="en"/>
                                        </ComboBox>
                                        
                                        <!-- FFMPEG 状态 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                            <TextBlock Text="FFmpeg 状态:" Foreground="#8B8F9A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="TxtFfmpegStatus" Text="检测中..." Foreground="#8B8F9A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnDownloadFfmpeg" Content="安装 FFmpeg" Style="{DynamicResource MaterialDesignOutlinedButton}" Visibility="Collapsed" Click="BtnDownloadFfmpeg_Click"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="ProgFfmpegDownload" Visibility="Collapsed" Margin="0,5,0,0" Height="2" Minimum="0" Maximum="100"/>
                                    </StackPanel>

                                        <StackPanel x:Name="PanelSubtitleConfig" Visibility="Visible">
                                            <TextBlock Text="截图区域识别字幕" Foreground="#8B8F9A" Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                                                <Button x:Name="BtnDrawCropArea" Content="在画面上框选字幕区域" Style="{DynamicResource MaterialDesignOutlinedButton}" Click="BtnDrawCropArea_Click" Margin="0,0,10,0"/>
                                                <Button x:Name="BtnConfirmCropArea" Content="确定框选" Visibility="Collapsed" Style="{DynamicResource MaterialDesignRaisedButton}" Background="#414DE5" Foreground="White" Click="BtnConfirmCropArea_Click" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="TxtCropArea" Text="尚未框选" VerticalAlignment="Center" Foreground="#E2E2E6"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel x:Name="PanelOcrConfig" Visibility="Collapsed">
                                        <StackPanel Margin="0,15,0,0" HorizontalAlignment="Left">
                                            <Button x:Name="BtnSnapshotAndOcr" Content="当前时间截图并识别" Style="{DynamicResource MaterialDesignRaisedButton}" Background="#414DE5" Foreground="White" Click="BtnSnapshotAndOcr_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="SnapshotHistoryPanel" Orientation="Horizontal">
                                                    <!-- History items will be added here -->
                                                </StackPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                        </StackPanel>

                                        <!-- YouTube Subtitle Language Selector -->
                                        <StackPanel x:Name="PanelYtSubtitleLanguage" Visibility="Collapsed">
                                            <TextBlock Text="字幕语言:" Foreground="#8B8F9A" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CmbYtSubtitleLanguage" Width="300" HorizontalAlignment="Left" Style="{DynamicResource MaterialDesignOutlinedComboBox}"/>
                                        </StackPanel>
                                    </Grid>
                            </Grid>
                            </ScrollViewer>
                        </materialDesign:Card>
                    </Grid>

                    <!-- 右侧半边：识别结果可编辑区 -->
                    <materialDesign:Card x:Name="RightColumnCard" Grid.Column="2" Background="#161923" UniformCornerRadius="12" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TabControl x:Name="ResultTabControl" Grid.Row="0" Grid.RowSpan="2">
                                <TabItem Header="识别结果">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,5,0,10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <RadioButton x:Name="RbWithTime" Content="带时间" IsChecked="True" Checked="RbResultView_Checked" Margin="0,0,10,0" Foreground="#8B8F9A"/>
                                                <RadioButton x:Name="RbPureText" Content="纯文本" Checked="RbResultView_Checked" Foreground="#8B8F9A"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="BtnClearResult" Content="清空" Style="{DynamicResource MaterialDesignFlatButton}" Height="30" Foreground="#EF4444" Padding="5,0" Click="BtnClearResult_Click"/>
                                                <Button x:Name="BtnCopyResult" Content="复制" Style="{DynamicResource MaterialDesignFlatButton}" Height="30" Foreground="#E2E2E6" Padding="5,0" Click="BtnCopyResult_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBox Grid.Row="1" x:Name="TxtOcrResult" TextChanged="TxtResult_TextChanged" Style="{DynamicResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0E1015" Foreground="#E2E2E6" FontFamily="Consolas" BorderThickness="1" BorderBrush="#2B2D38" Padding="10"/>
                                        <TextBox Grid.Row="1" x:Name="TxtPureOcrResult" TextChanged="TxtResult_TextChanged" Visibility="Collapsed" Style="{DynamicResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0E1015" Foreground="#E2E2E6" FontFamily="Consolas" BorderThickness="1" BorderBrush="#2B2D38" Padding="10"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Markdown">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <WebBrowser x:Name="MarkdownViewer" Grid.Row="0"/>
                                        <TextBox x:Name="TxtMarkdownEditor" Grid.Row="0" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0E1015" Foreground="#E2E2E6" BorderThickness="1" BorderBrush="#2B2D38" Padding="10"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button x:Name="BtnEditMarkdown" Content="编辑" Style="{DynamicResource MaterialDesignFlatButton}" Click="BtnEditMarkdown_Click"/>
                                            <Button x:Name="BtnSaveMarkdown" Content="保存" Style="{DynamicResource MaterialDesignFlatButton}" Visibility="Collapsed" Click="BtnSaveMarkdown_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                            
                            <StackPanel Grid.Row="2" Margin="0,15,0,0">
                                
                                <Grid>
                                    <Button x:Name="BtnGenerateMarkdown" IsEnabled="False" Content="生成Markdown" Style="{DynamicResource MaterialDesignRaisedButton}" Background="#414DE5" Click="BtnGenerateMarkdown_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <!-- 右侧边栏：归档与统计 -->
            <ScrollViewer x:Name="RightSidebar" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Background="#161923" UniformCornerRadius="12" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="归档设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                            
                            <TextBlock Text="目标知识库" Foreground="#8B8F9A" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbKnowledgeBase" Style="{DynamicResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,15"/>

                            <TextBlock Text="存储位置 (对应当前视频在知识库下的文件夹)" Foreground="#8B8F9A" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtStorageLocation" Style="{DynamicResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15" materialDesign:HintAssist.Hint="默认使用Markdown的title"/>

                            <TextBlock Text="文件名" Foreground="#8B8F9A" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtFileName" Style="{DynamicResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,15" materialDesign:HintAssist.Hint="默认使用Markdown的title"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="1" Background="#161923" UniformCornerRadius="12" Padding="15">
                        <StackPanel>
                            <TextBlock Text="字数统计" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                            
                            <Grid Margin="0,5">
                                <TextBlock Text="文案字数" Foreground="#8B8F9A"/>
                                <TextBlock x:Name="TxtWordCount" Text="0 字" HorizontalAlignment="Right" Foreground="#E2E2E6"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <TextBlock Text="Markdown 大小" Foreground="#8B8F9A"/>
                                <TextBlock x:Name="TxtMarkdownSize" Text="0 KB" HorizontalAlignment="Right" Foreground="#E2E2E6"/>
                            </Grid>
                            <Grid Margin="0,5,0,20">
                                <TextBlock Text="字符数" Foreground="#8B8F9A"/>
                                <TextBlock x:Name="TxtCharCount" Text="0" HorizontalAlignment="Right" Foreground="#E2E2E6"/>
                            </Grid>

                            <Button x:Name="BtnArchive" IsEnabled="False" Content="开始归档" Style="{DynamicResource MaterialDesignRaisedButton}" Background="#414DE5" Foreground="White" Margin="0,0,0,10" Click="BtnArchive_Click"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
