<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- CefSharp 需要明确指定平台，不能使用 AnyCPU -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Resources\Images\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Images\logo v0.3.png" />
    <None Remove="Resources\Images\logo.png" />
    <None Remove="Resources\Images\logocharacters white.png" />
    <None Remove="Resources\Images\logocharacters.png" />
    <None Remove="Resources\Images\logocharacters1.png" />
    <None Remove="Resources\Images\profile picture.png" />
    <None Remove="Resources\Images\QR Code.png" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup Label="FFmpeg 视频处理">
    <PackageReference Include="CefSharp.Common" Version="126.2.180" />
    <PackageReference Include="CefSharp.Wpf" Version="126.2.180" />
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="126.2.180" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.7.1" />
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" />
    <PackageReference Include="PaddleOCRSharp" Version="6.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup Label="工具库">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Images\logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Images\logo v0.3.png" />
    <Resource Include="Resources\Images\logo.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\logocharacters white.png" />
    <Resource Include="Resources\Images\logocharacters.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Images\logocharacters1.png" />
    <Resource Include="Resources\Images\profile picture.png" />
    <Resource Include="Resources\Images\QR Code.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NoteFlow.Studio.Infrastructure\NoteFlow.Studio.Infrastructure.csproj" />
    <ProjectReference Include="..\NoteFlow.Studio.Model\NoteFlow.Studio.Model.csproj" />
    <ProjectReference Include="..\NoteFlow.Studio.Repository\NoteFlow.Studio.Repository.csproj" />
    <ProjectReference Include="..\NoteFlow.Studio.Service\NoteFlow.Studio.Service.csproj" />
  </ItemGroup>

  <!-- 自动复制支持 H.264 视频播放的自定义 CefSharp DLL 到原生运行目录 -->
  <Target Name="CopyCustomCefDlls" AfterTargets="Build;Publish">
    <ItemGroup>
      <CustomCefFiles Include="..\cefsharp可用dll-放到bin-Debug-net8.0-windows-runtimes-win-x64-native\*.*" />
    </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>
    <Message Text="[%([CustomCefFiles.Filename])] 正在复制自定义的 CefSharp 文件以支持H264..." Importance="high" />
    <Copy SourceFiles="@(CustomCefFiles)" DestinationFolder="$(OutDir)runtimes\win-x64\native" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
