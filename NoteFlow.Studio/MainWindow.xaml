<Window x:Class="NoteFlow.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NoteFlow.Studio"
        xmlns:views="clr-namespace:NoteFlow.Studio.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="Microsoft YaHei, SimSun, {materialDesign:MaterialDesignFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Title="NoteFlow Studio" Height="800" Width="1400" WindowStartupLocation="CenterScreen" WindowStyle="None">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource AppRootBackground}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7,7,7,56"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. 左侧菜单栏 -->
        <Border Grid.Column="0" Background="{StaticResource AppRootBackground}" Margin="0,0,10,0">
            <DockPanel>
                
                <!-- 顶部 Logo 区域 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,30,0,0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="/Resources/Images/logo v0.3.png" Width="50" Height="50" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <Image Source="/Resources/Images/logocharacters white.png" Height="14" HorizontalAlignment="Left" Margin="0,0,0,5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="视频 · AI · 知识库" Foreground="{StaticResource AppTextForeground}" FontSize="14" />
                    </StackPanel>
                </StackPanel>

                <!-- 底部统计区：已有知识库 -->
                <!--<materialDesign:Card DockPanel.Dock="Bottom" Margin="15" Padding="15" UniformCornerRadius="12" Background="#1C1F2B">
                    <StackPanel>
                        <TextBlock Text="已有知识库" Foreground="{StaticResource AppTextForeground}" FontFamily="Microsoft YaHei" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid>
                            --><!-- 环形进度条 --><!--
                            <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" Value="25" Width="130" Height="130" Foreground="{StaticResource AppPrimaryAccent}" Background="#2B2D38" Maximum="100"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="128.5 GB" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="/ 500 GB" Foreground="{StaticResource AppTextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="已占用" Foreground="{StaticResource AppTextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="总容量 25%" Foreground="{StaticResource AppTextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                    </StackPanel>
                </materialDesign:Card>-->

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,30,10,10">
                            <ListBox x:Name="MenuListBox" PreviewMouseWheel="MenuListBox_PreviewMouseWheel" SelectionChanged="MenuListBox_SelectionChanged" Style="{DynamicResource MaterialDesignNavigationPrimaryListBox}" Foreground="{StaticResource AppTextMuted}" Background="Transparent" BorderThickness="0">
                            <ListBox.Resources>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignNavigationPrimaryListBoxItem}">
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                </Style>
                            </ListBox.Resources>

                            <!-- 浏览项（调整为与普通菜单项一致，并增加下边距区分组别） -->
                            <ListBoxItem x:Name="MenuHome" IsSelected="True" Margin="4,0,0,15">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="CompassOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="浏览" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>

                            <!-- 分类：内容处理 -->
                            <TextBlock Text="内容处理" Foreground="{StaticResource AppTextMuted}" Margin="10,0,10,5" FontSize="12"/>
                            <ListBoxItem x:Name="MenuAddKnowledgeBase">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="ArchivePlusOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="加入知识库" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="MenuFeishuCapture">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="网页内容抓取" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="MenuVideoGeneration">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="ArchivePlusOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="生成Remotion" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="MenuVideoRecreation">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="MovieEditOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="视频片段复刻" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="MenuRemotionHistory">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="History" VerticalAlignment="Center" />
                                    <TextBlock Text="Remotion历史记录" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <!--<ListBoxItem>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="Download" VerticalAlignment="Center" />
                                    <TextBlock Text="下载管理" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="BriefcaseOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="素材库" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>

                            --><!-- 分类：知识库 --><!--
                            <TextBlock Text="知识库" Foreground="{StaticResource AppTextMuted}" Margin="10,20,10,5" FontSize="12"/>
                            <ListBoxItem x:Name="MenuAddKnowledgeBase">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="ArchivePlusOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="加入知识库" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="ArchiveOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="我的知识库" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="StorefrontOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="知识库广场" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="TagOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="标签管理" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>

                            --><!-- 分类：AI 助手 --><!--
                            <TextBlock Text="AI 助手" Foreground="{StaticResource AppTextMuted}" Margin="10,20,10,5" FontSize="12"/>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="RobotOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="智能问答" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="History" VerticalAlignment="Center" />
                                    <TextBlock Text="对话历史" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>-->

                            <!-- 分类：系统 -->
                            <TextBlock Text="系统" Foreground="{StaticResource AppTextMuted}" Margin="10,20,10,5" FontSize="12"/>
                            <ListBoxItem x:Name="MenuBasicSettings">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="CogOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="基础设置" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="MenuLLMSettings">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="Brain" VerticalAlignment="Center" />
                                    <TextBlock Text="大模型设置" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="MenuLog">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="NoteTextOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="日志" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="MenuAbout">
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center" />
                                    <TextBlock Text="关于我" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 右上角自定义窗口控制按钮 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="999">
                <Button Style="{DynamicResource MaterialDesignFlatButton}" Width="46" Height="32" Padding="0" Click="BtnMinimize_Click" Foreground="{StaticResource AppTextMuted}" ToolTip="最小化">
                    <materialDesign:PackIcon Kind="WindowMinimize" />
                </Button>
                <Button Style="{DynamicResource MaterialDesignFlatButton}" Width="46" Height="32" Padding="0" Click="BtnMaximize_Click" Foreground="{StaticResource AppTextMuted}" ToolTip="最大化/还原">
                    <materialDesign:PackIcon Kind="WindowMaximize" />
                </Button>
                <Button Style="{DynamicResource MaterialDesignFlatButton}" Width="46" Height="32" Padding="0" Click="BtnClose_Click" Foreground="{StaticResource AppTextMuted}" ToolTip="关闭">
                    <materialDesign:PackIcon Kind="WindowClose" />
                </Button>
            </StackPanel>

            <!-- 页面承载区 -->
            <ContentControl x:Name="PageHost" Grid.Row="0" />

            <!-- 6. 最下方statusbar -->
            <StatusBar Grid.Row="1" DockPanel.Dock="Bottom" Background="#0E1015" Foreground="{StaticResource AppRootBackground}" BorderThickness="0,1,0,0" BorderBrush="#0E1015">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ScriptTextOutline" Foreground="{StaticResource AppTextMuted}" Margin="5,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="系统日志:" Foreground="{StaticResource AppTextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1">
                    <Button Style="{DynamicResource MaterialDesignFlatButton}" Foreground="{StaticResource AppTextForeground}" Height="Auto" Padding="5,2" HorizontalAlignment="Left" ToolTip="点击查看详细日志" Click="BtnViewLogs_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="IconStatusLight" Kind="Circle" Foreground="LimeGreen" VerticalAlignment="Center" Margin="0,0,5,0" Width="14" Height="14"/>
                            <TextBlock x:Name="TxtStatusLog" Text="系统运行正常" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StatusBarItem>
                <StatusBarItem Grid.Column="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                        <TextBlock Text="yt-dlp:" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource AppTextMuted}"/>
                        <materialDesign:PackIcon x:Name="IconYtdlpStatus" Kind="Circle" Foreground="Red" VerticalAlignment="Center" Margin="0,0,5,0" Width="14" Height="14"/>
                        <Button x:Name="BtnYtdlpAction" Content="安装" Style="{DynamicResource MaterialDesignOutlinedButton}" Height="25" Padding="5,0" FontSize="11" Click="BtnYtdlpAction_Click"/>
                        <ProgressBar x:Name="ProgYtdlpDownload" Visibility="Collapsed" Width="60" Height="4" Margin="5,0,0,0"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem Grid.Column="3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前模型:" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{StaticResource AppTextMuted}"/>
                        <ComboBox x:Name="CmbGlobalModel" Width="150" DisplayMemberPath="Name" SelectedIndex="0" Style="{DynamicResource MaterialDesignDataGridComboBox}"></ComboBox>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>




